{
  "expo": {
    "name": "WOPR",
    "slug": "wopr-mobile",
    "scheme": "wopr",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "network.wopr.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "network.wopr.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a"
      }
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
